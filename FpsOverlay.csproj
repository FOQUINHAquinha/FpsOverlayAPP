<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FPSOverlay</AssemblyName>
    <RootNamespace>FpsOverlay</RootNamespace>
    <Version>1.0.0</Version>
    <Product>FPS Overlay</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001;CA1416;NU1701</NoWarn>

    <!-- Um único .exe que roda sem instalar .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- O workflow do GitHub baixa o PresentMon.exe e ele vai embutido no app -->
    <EmbeddedResource Include="PresentMon.exe" LogicalName="PresentMon.exe" Condition="Exists('PresentMon.exe')" />
  </ItemGroup>

</Project>
