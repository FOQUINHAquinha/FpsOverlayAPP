<Window x:Class="FpsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay" Width="540" Height="760" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="20,16,20,12">
            <TextBlock Text="FPS Overlay" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" Text="Iniciando..." Style="{StaticResource Lbl}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,8">

                <!-- Agora -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Agora" Style="{StaticResource H}" />
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock x:Name="FpsText" Text="--" Style="{StaticResource Big}" Foreground="#76D72E" />
                                <TextBlock Text="FPS" Style="{StaticResource Lbl}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="Low1Text" Text="--" Style="{StaticResource Big}" />
                                <TextBlock Text="1% low" Style="{StaticResource Lbl}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="Low01Text" Text="--" Style="{StaticResource Big}" />
                                <TextBlock Text="0.1% low" Style="{StaticResource Lbl}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="AvgText" Text="--" Style="{StaticResource Big}" />
                                <TextBlock Text="Média" Style="{StaticResource Lbl}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="GameText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.85"
                                   Text="Nenhum jogo detectado." />
                        <Button x:Name="ResetButton" Content="Zerar estatísticas" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Click="ResetButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Hardware -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hardware detectado" Style="{StaticResource H}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Placa de vídeo" Style="{StaticResource Lbl}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="GpuCombo" SelectionChanged="GpuCombo_SelectionChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GpuLiveText" Margin="0,6,0,10" Opacity="0.85" Text="--" />
                            <TextBlock Grid.Row="2" Text="Processador" Style="{StaticResource Lbl}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CpuNameText" FontWeight="SemiBold" Text="--" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuLiveText" Margin="0,6,0,10" Opacity="0.85" Text="--" />
                            <TextBlock Grid.Row="4" Text="Memória" Style="{StaticResource Lbl}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RamText" Opacity="0.85" Text="--" />
                        </Grid>
                        <Border x:Name="PawnHint" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                                Background="#22FFB020" BorderBrush="#55FFB020" BorderThickness="1">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Temperatura, potência e clock da CPU precisam do driver gratuito PawnIO (o mesmo usado pelo LibreHardwareMonitor e pelo FanControl). Instale e reabra o FPS Overlay." />
                                <Button Content="Baixar PawnIO (pawnio.eu)" Margin="0,8,0,0" HorizontalAlignment="Left" Click="PawnButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Overlay -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Overlay" Style="{StaticResource H}" />
                        <CheckBox x:Name="ShowOverlayCheck" Content="Mostrar overlay nos jogos" Click="ShowOverlayCheck_Click" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Posição" Style="{StaticResource Lbl}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PositionCombo" Margin="0,0,0,8"
                                      SelectionChanged="PositionCombo_SelectionChanged">
                                <ComboBoxItem Tag="TopLeft" Content="Canto superior esquerdo" />
                                <ComboBoxItem Tag="TopRight" Content="Canto superior direito" />
                                <ComboBoxItem Tag="BottomLeft" Content="Canto inferior esquerdo" />
                                <ComboBoxItem Tag="BottomRight" Content="Canto inferior direito" />
                                <ComboBoxItem Tag="Custom" Content="Personalizada (arrastada)" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Tamanho" Style="{StaticResource Lbl}" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="ScaleSlider" Minimum="0.5" Maximum="2.5"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="ScaleSlider_ValueChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ScaleText" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="Fundo" Style="{StaticResource Lbl}" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OpacityText" Text="72%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Mostrar no overlay" Style="{StaticResource Lbl}" Margin="0,12,0,4" />
                        <WrapPanel>
                            <CheckBox x:Name="GraphCheck" Content="Gráfico de frametime" Margin="0,0,16,0" Click="SectionCheck_Click" />
                            <CheckBox x:Name="GpuCheck" Content="GPU" Margin="0,0,16,0" Click="SectionCheck_Click" />
                            <CheckBox x:Name="CpuCheck" Content="CPU" Margin="0,0,16,0" Click="SectionCheck_Click" />
                            <CheckBox x:Name="RamCheck" Content="RAM / API" Click="SectionCheck_Click" />
                        </WrapPanel>
                        <Button x:Name="MoveButton" Content="Mover overlay" Margin="0,12,0,0" HorizontalAlignment="Left" Click="MoveButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Estatísticas -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Estatísticas" Style="{StaticResource H}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="1% / 0.1% low" Style="{StaticResource Lbl}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LowsCombo" Margin="0,0,0,8" SelectionChanged="LowsCombo_SelectionChanged">
                                <ComboBoxItem Tag="percentile" Content="Percentil (igual ao Afterburner)" />
                                <ComboBoxItem Tag="average" Content="Média dos piores frames" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Período" Style="{StaticResource Lbl}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="WindowCombo" SelectionChanged="WindowCombo_SelectionChanged">
                                <ComboBoxItem Tag="0" Content="Desde que o jogo abriu (ou do último reset)" />
                                <ComboBoxItem Tag="30" Content="Últimos 30 segundos" />
                                <ComboBoxItem Tag="60" Content="Últimos 60 segundos" />
                                <ComboBoxItem Tag="300" Content="Últimos 5 minutos" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sistema -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sistema" Style="{StaticResource H}" />
                        <CheckBox x:Name="StartupCheck" Content="Iniciar junto com o Windows" Click="StartupCheck_Click" />
                        <CheckBox x:Name="MinimizedCheck" Content="Abrir direto na bandeja (sem mostrar esta janela)" Margin="0,6,0,0" Click="MinimizedCheck_Click" />
                        <TextBlock x:Name="HotkeysText" Margin="0,12,0,0" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="20,8,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fechar esta janela mantém o app rodando na bandeja." Style="{StaticResource Lbl}" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Sair do app" Margin="12,0,0,0" Click="QuitButton_Click" />
        </Grid>
    </Grid>
</Window>
